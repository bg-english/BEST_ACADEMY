# Públicas (van al navegador) — seguras de exponer, controladas por RLS
NEXT_PUBLIC_SUPABASE_URL=https://cuynuqycsiexwfcwshys.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# SOLO servidor — NUNCA con prefijo NEXT_PUBLIC. Se usa en las rutas /api para
# crear alumnos y resetear PINs. Configúrala en Vercel como variable de entorno.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SOLO servidor — calificador de IA (área de teoría). Consíguela en
# https://console.anthropic.com/ → API Keys. Configúrala también en Vercel.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
